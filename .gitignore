# --- caches / editor / OS cruft ---
__pycache__/
*.pyc
.DS_Store
.vscode
*.code-workspace
attic/
.refs/

# --- generated workspaces under tutorials/ (each notebook builds its own) ---
# Each part1 notebook builds the workspace the next consumes; none of those are
# tracked. Names below cover every workspace the notebooks create: *_template*
# (pst/obs/dsi/dsivc templates and their sweeps), master_* (IES/MOU run dirs),
# tmp/tmp_*, full_model_* (part1_06), and *_sweep / *_training_sweep (part1_08).
tutorials/**/master_*/
tutorials/**/*_template*/
tutorials/**/tmp/
tutorials/**/tmp_*/
tutorials/**/workspace*/
tutorials/**/model/
tutorials/**/full_model_*/
tutorials/**/*_sweep/
tutorials/**/dw_*/

# --- root-level legacy generated dirs (expensive run results; not tracked) ---
model/
pst_template*/
master_*/
priormc/
tmp/
dsi_template/

# --- generated grid (written by part1_01 into its workspace, never data/) ---
data/mf6_grid.*

# --- root debris (anchored to repo root so docs/, data/ and tutorial figures
#     stay trackable; tutorial-generated figures live in ignored workspaces) ---
/*.pdf
/*.png
/*.log
/*.nans.csv
/PstFrom.log
/forward_run.py
tutorials/**/column/
tutorials/**/PstFrom.log

# parallel run workers and staging (repo root, transient)
/worker_*/
/pst_template_*_stage/
/master_sweep/
/master_hm_v2/
/master_priormc_v2/

# workflow prototype scaffolding
_workflow/_figs/
_workflow/__pycache__/
_workflow/_s2_model/
_workflow/_s2_pristine/
_workflow/_s3_template/
_workflow/_s3_stage/
_workflow/_s2_model/
_workflow/_s2_pristine/
_workflow/_s5_master/
_workflow/_s5_workers/
_workflow/_truth/
_workflow/_truth_props/
_workflow/_s6_dsi_template/
_workflow/_s6_loo_dsi/
_workflow/_s6_fig_*/
# catch-all for every generated workspace (mothership): _s2/_s3/_s5/_s6*/_s7* + scratch
_workflow/_s*/
_workflow/_treat_scratch/
_workflow/_s5_master_snap*/
